# Supply [database] connection through an owner-restricted deployment config.
# Never copy a real database URL or service credential into this repository.

[reconciliation]
mode = once
authentication_mode = maintenance
upstream_url = https://registry-internal.example
cafile = /etc/coffer/backend-ca.crt

# This exact private endpoint requires the per-worker client certificate.
maintenance_token_url = https://registry-maintenance.internal.example/v1/internal/maintenance/registry-token
maintenance_timeout_seconds = 10
application_credential_id_file = /etc/coffer/maintenance-application-credential-id
application_credential_secret_file = /etc/coffer/maintenance-application-credential-secret
maintenance_client_certfile = /etc/coffer/maintenance-client.crt
maintenance_client_keyfile = /etc/coffer/maintenance-client.key
maintenance_service_project_id = replace-with-service-project-id
maintenance_user_id = replace-with-user-id
worker_id = reconciler-region-one-a

# Production requires authenticated HTTPS. Plaintext is accepted only with
# authentication_mode=unauthenticated_fixture and a loopback origin.
allow_insecure_http = false

timeout_seconds = 10
stale_after_seconds = 300
batch_limit = 10
max_pages_per_cycle = 100
# Cover each candidate's Registry, broker, and Keystone timeout plus mutation
# grace. With the values in this sample the minimum is 310 seconds.
lease_seconds = 450

# Used only when mode = periodic.
interval_seconds = 60
jitter_fraction = 0.1
retry_initial_seconds = 5
retry_max_seconds = 60
# management_bind_host = 127.0.0.1
# management_bind_port = 8790
# management_tls_certfile = /etc/coffer/reconcile-metrics.crt
# management_tls_keyfile = /etc/coffer/reconcile-metrics.key

# worker_id selects one exact maintenance workload. The database claim token
# and expected reservation version remain the mutation fencing authority.

[keystone]
auth_url = https://keystone.internal.example/v3
cafile = /etc/coffer/backend-ca.crt
insecure = false
timeout = 10
