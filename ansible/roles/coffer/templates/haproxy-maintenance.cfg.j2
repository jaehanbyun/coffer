# Generated by the Coffer companion role. This listener is private and mTLS-only.
frontend coffer_maintenance_front
    mode http
    bind {{ kolla_internal_vip_address }}:{{ coffer_maintenance_port }} ssl crt /etc/haproxy/certificates/haproxy-internal.pem ca-file /var/lib/kolla/share/ca-certificates/coffer-maintenance-client-ca.crt verify required alpn http/1.1
    http-request del-header X-Coffer-Maintenance-Workload
    acl coffer_maintenance_method method POST
    acl coffer_maintenance_path path -m str /v1/internal/maintenance/registry-token
    acl coffer_maintenance_verified ssl_c_used ssl_c_verify 0
{% for result in coffer_maintenance_certificate_fingerprints.results %}
{% set fingerprint = result.stdout.split('=', 1)[1] | replace(':', '') | lower %}
    acl coffer_maintenance_cert_{{ loop.index }} ssl_c_der,sha2(256),hex -m str {{ fingerprint }}
    http-request set-header X-Coffer-Maintenance-Workload {{ result.item.workload_id }} if coffer_maintenance_cert_{{ loop.index }}
{% endfor %}
    http-request deny unless coffer_maintenance_method coffer_maintenance_path coffer_maintenance_verified
    http-request deny unless {% for result in coffer_maintenance_certificate_fingerprints.results %}coffer_maintenance_cert_{{ loop.index }}{% if not loop.last %} or {% endif %}{% endfor %}
    default_backend coffer_maintenance_back

backend coffer_maintenance_back
    mode http
    option httpchk GET /healthz
    http-check expect status 200
{% for host in groups['coffer-api'] %}
    server {{ hostvars[host].ansible_facts.hostname }} {{ 'api' | kolla_address(host) }}:{{ coffer_api_port }} {{ haproxy_health_check_ssl }} ssl verify required ca-file {{ haproxy_backend_cacert }}
{% endfor %}
